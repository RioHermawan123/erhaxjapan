:root {
  --bg-color: #0F172A; /* Slate 900, latar utama nyaman */
  --surface: #1E293B;  /* Slate 800, kartu lebih terang agar font tidak menyatu */
  --surface-elevated: #2D3748;  /* Slate 700, kartu lebih dalam */
  --text-main: #F8FAFC; /* Slate 50 */
  --text-muted: #94A3B8; /* Slate 400, kontras lebih baik */
  --border: #334155; /* Slate 700, tepi elemen terlihat jelas */

  --success: #10B981;
  --success-bg: rgba(16, 185, 129, 0.15);
  --error: #EF4444;
  --error-bg: rgba(239, 68, 68, 0.15);

  /* Cool / Masculine Vibrant Colors */
  --matcha: #10B981; /* Emerald */
  --matcha-bg: rgba(16, 185, 129, 0.15);
  --sakura: #EF4444; /* Crimson Red */
  --sakura-bg: rgba(239, 68, 68, 0.15);
  --fuji: #3B82F6; /* Royal Blue */
  --fuji-bg: rgba(59, 130, 246, 0.15);
  --mikan: #F97316; /* Neon Orange */
  --mikan-bg: rgba(249, 115, 22, 0.15);
  --yuzu: #F59E0B; /* Amber/Gold */
  --yuzu-bg: rgba(245, 158, 11, 0.15);
  --murasaki: #8B5CF6; /* Violet */
  --murasaki-bg: rgba(139, 92, 246, 0.15);
  --sora: #06B6D4; /* Cyan */
  --sora-bg: rgba(6, 182, 212, 0.15);

  --shadow-sm: 0 2px 8px -2px rgba(0, 0, 0, 0.4);
  --shadow-md: 0 8px 16px -4px rgba(0, 0, 0, 0.5);
  --shadow-lg: 0 16px 32px -8px rgba(0, 0, 0, 0.6);
  --shadow-xl: 0 24px 48px -12px rgba(0, 0, 0, 0.7);

  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 22px;
  --radius-full: 9999px;

  --safe-top: env(safe-area-inset-top, 0px);
  --safe-right: env(safe-area-inset-right, 0px);
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  --safe-left: env(safe-area-inset-left, 0px);
  --mobile-nav-height: 68px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  overflow-x: hidden;
  width: 100%;
}

body {
  font-family: 'Inter', sans-serif;
  background-color: var(--bg-color);
  color: var(--text-main);
  line-height: 1.5;
  padding: 24px 16px;
  min-height: 100vh;
  min-height: 100dvh;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  overflow-x: hidden;
  width: 100%;
  box-sizing: border-box;
}

.japanese-font {
  font-family: 'M PLUS Rounded 1c', sans-serif;
}

.app-container {
